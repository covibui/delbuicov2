# --- Required ---
# Postgres connection string. On Vercel, the Neon integration fills this in for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delbuico
# Any long random string. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me

# --- Production ---
# Vercel Blob (photos). Added automatically when you create a Blob store in the Vercel project.
BLOB_READ_WRITE_TOKEN=
# Resend (invite + password emails). Without it, emails are printed to the server log.
RESEND_API_KEY=
# The address emails come from. "onboarding@resend.dev" works for testing but only
# delivers to your own Resend account email — verify a domain in Resend for real invites.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Optional: your site's public URL (used in email links). Vercel's URL is used if blank.
NEXT_PUBLIC_SERVER_URL=

# --- One-time import (npm run seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
