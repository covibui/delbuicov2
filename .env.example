# --- Required ---
# Postgres connection string. On Vercel, the Neon integration fills this in for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delbuico
# Any long random string. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me

# --- Production ---
# Vercel Blob (photos). Added automatically when you create a Blob store in the Vercel project.
BLOB_READ_WRITE_TOKEN=

# --- Command-line import only (npm run seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
